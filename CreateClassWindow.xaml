<Window x:Class="Sikai_Project.CreateClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIKAI - Create class"
        Width="480"
        Height="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource GbaPageBg}">

    <Border Margin="24"
            Padding="26"
            Background="{StaticResource GbaScreenBg}"
            BorderBrush="{StaticResource GbaScreenBezel}"
            BorderThickness="3"
            CornerRadius="10">

        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="CREATE A CLASS"
                       FontFamily="{StaticResource PixelFont}"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="{StaticResource GbaInk}"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Class name" Style="{StaticResource GbaLabel}"/>
            <TextBox x:Name="ClassNameBox" Style="{StaticResource GbaTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="Class code" Style="{StaticResource GbaLabel}"/>
            <TextBox x:Name="ClassCodeBox" Style="{StaticResource GbaTextBox}" Margin="0,0,0,12"/>

            <TextBlock Text="This class will belong to your teacher account."
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Foreground="{StaticResource GbaInkMuted}"/>

            <TextBlock x:Name="FormError"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Style="{StaticResource GbaErrorText}"/>
            <TextBlock x:Name="FormSuccess"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource PixelFont}"
                       FontWeight="Bold"
                       FontSize="12"
                       Foreground="{StaticResource GbaAccentGreen}"
                       Visibility="Collapsed"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="BACK"
                        Margin="0,0,6,0"
                        Style="{StaticResource GbaButtonOutline}"
                        Click="Back_Click"/>
                <Button x:Name="CreateButton"
                        Grid.Column="1"
                        Content="CREATE"
                        Margin="6,0,0,0"
                        Background="{StaticResource GbaAccentGreen}"
                        Style="{StaticResource GbaButton}"
                        Click="Create_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
