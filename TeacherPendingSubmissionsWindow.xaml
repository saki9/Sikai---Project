<Window x:Class="Sikai_Project.TeacherPendingSubmissionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pending Submissions - SIKAI" Height="780" Width="1250" WindowStartupLocation="CenterScreen" Background="#FAF9FE">
 <Window.Resources><Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#55516B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="6,2"/></Style><Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#7567D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/></Style></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White"><Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions><TextBlock Text="SIKAI" FontSize="27" FontWeight="Bold" Foreground="#7567D9" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Row="1"><Button Content="⌂  Dashboard" Style="{StaticResource NavButton}" Click="Dashboard_Click"/><Button Content="▤  Courses" Style="{StaticResource NavButton}" Click="Courses_Click"/><Button Content="☺  Students" Style="{StaticResource NavButton}" Click="Students_Click"/><Button Content="▣  Learning Materials" Style="{StaticResource NavButton}" Click="Materials_Click"/><Button Content="✓  Assignments" Style="{StaticResource NavButton}" Click="Assignments_Click"/><Button Content="◷  Pending Submissions" Style="{StaticResource NavButton}" Background="#F0EDFF" Foreground="#7567D9"/><Button Content="✉  Messages" Style="{StaticResource NavButton}" Click="Messages_Click"/></StackPanel><Button Grid.Row="2" Content="↪  Logout" Style="{StaticResource NavButton}" Click="Logout_Click"/></Grid></Border>
 <ScrollViewer Grid.Column="1"><StackPanel Margin="32"><TextBlock Text="Assignment Submissions" FontSize="30" FontWeight="Bold" Foreground="#29263A"/><TextBlock Text="Review student answers and provide feedback." Margin="0,6,0,22" Foreground="#77738A"/><TextBox x:Name="SearchBox" Height="38" Padding="8" Margin="0,0,0,14" ToolTip="Search by student, assignment, or subject" TextChanged="SearchBox_TextChanged"/><TextBlock x:Name="StatusText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel x:Name="SubmissionsPanel"/></StackPanel></ScrollViewer></Grid>
</Window>
