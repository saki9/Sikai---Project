<Window x:Class="Sikai_Project.EnrollClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enroll in Class - SIKAI"
        Height="640"
        Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#FAF9FE">

	<Grid Margin="40,20,40,30">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="20"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="30"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		
		<Button Grid.Row="0"
                x:Name="BackButton"
                Content="←  Back to Dashboard"
                HorizontalAlignment="Left"
                Padding="12,8"
                Margin="0,0,0,10"
                Background="Transparent"
                Foreground="#57536F"
                BorderThickness="0"
                FontSize="14"
                Cursor="Hand"
                Click="BackButton_Click"/>

		
		<TextBlock Grid.Row="1"
                   Text="Enroll in a Class"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#3F3A56"
                   HorizontalAlignment="Center"/>

		
		<TextBlock Grid.Row="3"
                   Text="Enter the class code given to you by your teacher."
                   FontSize="16"
                   Foreground="#666174"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

		
		<StackPanel Grid.Row="5">

			<TextBlock Text="Class Code"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#3F3A56"
                       Margin="0,0,0,8"/>

			<TextBox x:Name="ClassCodeTextBox"
                     Height="45"
                     FontSize="18"
                     Padding="12"
                     BorderBrush="#D5D0E5"
                     BorderThickness="1"/>

		</StackPanel>

		
		<Button Grid.Row="7"
                x:Name="EnrollButton"
                Content="Enroll"
                Width="180"
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#7567D9"
                Foreground="White"
                FontSize="17"
                FontWeight="SemiBold"
                BorderThickness="0"
                Click="EnrollButton_Click"
                IsDefault="True"/>

		
		<StackPanel Grid.Row="8" Margin="0,25,0,0">
			<TextBlock Text="My Classes"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#3F3A56"
                       Margin="0,0,0,10"/>
			<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
				<ItemsControl x:Name="MyClassesList"/>
			</ScrollViewer>
		</StackPanel>

	</Grid>
</Window>