<Window x:Class="Sikai_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIKAI Admin"
        Width="560"
        Height="640"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GbaPageBg}">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <DockPanel Grid.Row="0" Margin="4,0,4,14">
            <TextBlock DockPanel.Dock="Left"
                       x:Name="WelcomeText"
                       FontFamily="{StaticResource PixelFont}"
                       FontSize="12"
                       Foreground="{StaticResource GbaInkMuted}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="SIGN OUT"
                    Width="100"
                    Height="30"
                    Style="{StaticResource GbaButtonOutline}"
                    Click="SignOut_Click"/>
        </DockPanel>

        
        <Border Grid.Row="1"
                CornerRadius="26"
                Padding="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F6BE79" Offset="0"/>
                    <GradientStop Color="#F0A64E" Offset="0.55"/>
                    <GradientStop Color="#D98F3B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.25" Color="#5A3B12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0"
                        Background="{StaticResource GbaScreenBezel}"
                        CornerRadius="14"
                        Padding="10">
                    <Border Background="{StaticResource GbaScreenBg}" CornerRadius="4">
                        <StackPanel Margin="26,24" VerticalAlignment="Center">
                            <Button x:Name="Item1"
                                    Style="{StaticResource GbaMenuItem}"
                                    Click="CreateAccount_Click">
                                <TextBlock Text="1. Create new" TextWrapping="Wrap"/>
                            </Button>
                            <TextBlock Text="    account"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontWeight="Bold"
                                       FontSize="19"
                                       Foreground="{StaticResource GbaInk}"
                                       Margin="2,-6,0,4"/>

                            <Button x:Name="Item2"
                                    Style="{StaticResource GbaMenuItem}"
                                    Margin="0,10,0,0"
                                    Click="CreateClass_Click">
                                <TextBlock Text="2. Create new" TextWrapping="Wrap"/>
                            </Button>
                            <TextBlock Text="    class"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontWeight="Bold"
                                       FontSize="19"
                                       Foreground="{StaticResource GbaInk}"
                                       Margin="2,-6,0,4"/>

                            <Button x:Name="Item3"
                                    Style="{StaticResource GbaMenuItem}"
                                    Margin="0,10,0,0"
                                    Click="RemoveAccount_Click">
                                <TextBlock Text="3. Remove" TextWrapping="Wrap"/>
                            </Button>
                            <TextBlock Text="    account"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontWeight="Bold"
                                       FontSize="19"
                                       Foreground="{StaticResource GbaInk}"
                                       Margin="2,-6,0,4"/>
                        </StackPanel>
                    </Border>
                </Border>

                
                <Grid Grid.Row="1" Margin="10,22,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    
                    <Grid Grid.Column="0" Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Fill="{StaticResource GbaPad}"
                              Data="M 34,0 L 56,0 L 56,34 L 90,34 L 90,56 L 56,56 L 56,90 L 34,90 L 34,56 L 0,56 L 0,34 L 34,34 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.35" Color="#3A2410"/>
                            </Path.Effect>
                        </Path>
                        <Ellipse Width="14" Height="14" Fill="#26252A"/>
                    </Grid>

                    
                    <UniformGrid Grid.Column="1" Columns="4" Rows="3" Width="70" Height="52"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <UniformGrid.Resources>
                            <Style TargetType="Ellipse">
                                <Setter Property="Width" Value="7"/>
                                <Setter Property="Height" Value="7"/>
                                <Setter Property="Fill" Value="#B97B2E"/>
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </UniformGrid.Resources>
                        <Ellipse/><Ellipse/><Ellipse/><Ellipse/>
                        <Ellipse/><Ellipse/><Ellipse/><Ellipse/>
                        <Ellipse/><Ellipse/><Ellipse/><Ellipse/>
                    </UniformGrid>

                    
                    <Grid Grid.Column="2" Width="90" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="34" Height="34" Fill="#6E4A22" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        <Ellipse Width="34" Height="34" Fill="#6E4A22" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                        <TextBlock Text="A" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,10,0"
                                   FontFamily="{StaticResource PixelFont}" FontWeight="Bold" Foreground="#EFE3D2"/>
                        <TextBlock Text="B" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,7"
                                   FontFamily="{StaticResource PixelFont}" FontWeight="Bold" Foreground="#EFE3D2"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
