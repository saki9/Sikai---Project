<Window x:Class="Sikai_Project.TeacherMessagesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Messages - SIKAI" Height="780" Width="1250" WindowStartupLocation="CenterScreen" Background="#FAF9FE">
 <Window.Resources><Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#55516B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="6,2"/></Style><Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#7567D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/></Style></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="White"><Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions><TextBlock Text="SIKAI" FontSize="27" FontWeight="Bold" Foreground="#7567D9" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Row="1"><Button Content="⌂  Dashboard" Style="{StaticResource NavButton}" Click="Dashboard_Click"/><Button Content="▤  Courses" Style="{StaticResource NavButton}" Click="Courses_Click"/><Button Content="☺  Students" Style="{StaticResource NavButton}" Click="Students_Click"/><Button Content="▣  Learning Materials" Style="{StaticResource NavButton}" Click="Materials_Click"/><Button Content="✓  Assignments" Style="{StaticResource NavButton}" Click="Assignments_Click"/><Button Content="◷  Pending Submissions" Style="{StaticResource NavButton}" Click="Pending_Click"/><Button Content="✉  Messages" Style="{StaticResource NavButton}" Background="#F0EDFF" Foreground="#7567D9"/></StackPanel><Button Grid.Row="2" Content="↪  Logout" Style="{StaticResource NavButton}" Click="Logout_Click"/></Grid></Border>
 <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Messages" FontSize="30" FontWeight="Bold" Foreground="#29263A"/><TextBlock Text="Chat with students enrolled in your classes." Foreground="#77738A" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Class contacts" FontSize="18" FontWeight="SemiBold" Margin="4,3,4,10"/><ListBox x:Name="ContactsList" DisplayMemberPath="Display" SelectionChanged="ContactsList_SelectionChanged" BorderBrush="#E7E3EF"/></StackPanel>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ConversationTitle" Text="Choose a student to start chatting" FontSize="18" FontWeight="SemiBold" Margin="8,4,8,12"/><ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesPanel"/></ScrollViewer><TextBox Grid.Row="2" x:Name="MessageBox" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" Margin="8,8,8,8" VerticalScrollBarVisibility="Auto"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#77738A" Margin="0,0,12,0"/><Button Content="Send message" Style="{StaticResource PrimaryButton}" Click="Send_Click"/></StackPanel></Grid>
  </Grid></Border>
 </Grid></Grid>
</Window>
