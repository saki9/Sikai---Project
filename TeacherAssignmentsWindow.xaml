<Window x:Class="Sikai_Project.TeacherAssignmentsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Assignments - SIKAI" Height="780" Width="1250" WindowStartupLocation="CenterScreen" Background="#FAF9FE">
  <Window.Resources><Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#55516B"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,11"/><Setter Property="Margin" Value="6,2"/></Style><Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#7567D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="White"><Grid><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions><TextBlock Text="SIKAI" FontSize="27" FontWeight="Bold" Foreground="#7567D9" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Row="1"><Button Content="⌂  Dashboard" Style="{StaticResource NavButton}" Click="Dashboard_Click"/><Button Content="▤  Courses" Style="{StaticResource NavButton}" Click="Courses_Click"/><Button Content="☺  Students" Style="{StaticResource NavButton}" Click="Students_Click"/><Button Content="▣  Learning Materials" Style="{StaticResource NavButton}" Click="Materials_Click"/><Button Content="✓  Assignments" Style="{StaticResource NavButton}" Background="#F0EDFF" Foreground="#7567D9"/><Button Content="◷  Pending Submissions" Style="{StaticResource NavButton}" Click="Pending_Click"/><Button Content="✉  Messages" Style="{StaticResource NavButton}" Click="Messages_Click"/></StackPanel><Button Grid.Row="2" Content="↪  Logout" Style="{StaticResource NavButton}" Click="Logout_Click"/></Grid></Border>
    <ScrollViewer Grid.Column="1"><StackPanel Margin="32"><TextBlock Text="Assignments" FontSize="30" FontWeight="Bold" Foreground="#29263A"/><TextBlock Text="Create assignments and review what you have shared with your classes." Foreground="#77738A" Margin="0,6,0,22"/>
      <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,20"><StackPanel><TextBlock Text="Create assignment" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Class / Subject"/><ComboBox x:Name="SubjectComboBox" DisplayMemberPath="Name" Height="36" Margin="0,4,0,10"/><TextBlock Text="Assignment title"/><TextBox x:Name="TitleBox" Height="36" Padding="8" Margin="0,4,0,10"/><TextBlock Text="Instructions"/><TextBox x:Name="DescriptionBox" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" Margin="0,4,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Due date"/><DatePicker x:Name="DueDatePicker" Height="36" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Priority"/><ComboBox x:Name="PriorityComboBox" SelectedIndex="1" Height="36" Margin="0,4,0,0"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/></ComboBox></StackPanel></Grid><Button Content="Publish Assignment" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CreateAssignment_Click"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#B42318" Margin="0,10,0,0"/></StackPanel></Border>
      <TextBlock Text="Published assignments" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBox x:Name="SearchBox" Height="36" Padding="8" Margin="0,0,0,14" ToolTip="Search assignments" TextChanged="SearchBox_TextChanged"/><StackPanel x:Name="AssignmentsPanel"/>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
