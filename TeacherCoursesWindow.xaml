<Window x:Class="Sikai_Project.TeacherCoursesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Courses - SIKAI"
        Height="780"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#FAF9FE">

	<Window.Resources>

		<Style x:Key="NavButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#55516B"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="18,12"/>
			<Setter Property="Margin" Value="8,3"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="#7567D9"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="18,10"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>

		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="Margin" Value="0,0,16,16"/>
		</Style>

	</Window.Resources>

	<Grid>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		
		<Border Grid.Column="0"
                Background="White">

			<Grid>

				<Grid.RowDefinitions>
					<RowDefinition Height="90"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="70"/>
				</Grid.RowDefinitions>

				
				<TextBlock Text="SIKAI"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#7567D9"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

				
				<StackPanel Grid.Row="1">

					<Button Content="⌂  Dashboard"
                            Style="{StaticResource NavButton}"
                            Click="Dashboard_Click"/>

					<Button Content="▤  Courses"
                            Style="{StaticResource NavButton}"
                            Background="#F0EDFF"
                            Foreground="#7567D9"/>

					<Button Content="☺  Students"
                            Style="{StaticResource NavButton}"
                            Click="Students_Click"/>

					<Button Content="▣  Learning Materials"
                            Style="{StaticResource NavButton}"
                            Click="Materials_Click"/>

					<Button Content="✓  Assignments"
                            Style="{StaticResource NavButton}"
                            Click="Assignments_Click"/>

					<Button Content="◷  Pending Submissions"
                            Style="{StaticResource NavButton}"
                            Click="Pending_Click"/>

					<Button Content="✉  Messages"
                            Style="{StaticResource NavButton}"
                            Click="Messages_Click"/>

				</StackPanel>

				
				<Button Grid.Row="2"
                        Content="↪  Logout"
                        Style="{StaticResource NavButton}"
                        Click="Logout_Click"/>

			</Grid>

		</Border>


		
		<ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

			<StackPanel Margin="35">

				
				<Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" Margin="0,0,12,0">
						<TextBlock Text="My Courses"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#29263A"/>

						<TextBlock Text="Manage your courses and keep your students organized."
                                   FontSize="14"
                                   Foreground="#77738A"
                                   Margin="0,8,0,0"/>
					</StackPanel>

                    <Button Grid.Column="1"
                            Content="＋  Create Class"
                            Width="150"
                            Height="42"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}"
                            Click="CreateClass_Click"/>
				</Grid>


				
				<Border Background="White"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,25">

					<Grid>

						<TextBox x:Name="SearchBox"
                                 Height="38"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Padding="10"
                                 TextChanged="SearchBox_TextChanged"/>

						<TextBlock Text="Search courses..."
                                   Foreground="#AAA6B5"
                                   FontSize="14"
                                   Margin="12,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

					</Grid>

				</Border>


				
				<WrapPanel x:Name="CoursesPanel">

				</WrapPanel>

			</StackPanel>

		</ScrollViewer>

	</Grid>

</Window>