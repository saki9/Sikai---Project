<Window x:Class="Sikai_Project.ForgotPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIKAI - Reset password"
        Width="480"
        Height="720"
        MinHeight="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="40,30"
                Padding="40,36"
                Background="{StaticResource CardBg}"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#51465F"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="SIKAI"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource DarkText}"/>
                <TextBlock Text="Reset your password"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,6"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DarkText}"/>
                <TextBlock x:Name="IntroText"
                           Text="Enter your email and we'll ask your security question."
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource MutedText}"/>

                
                <StackPanel x:Name="Step1Panel">
                    <TextBlock Text="I am a" Style="{StaticResource FieldLabel}"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <RadioButton x:Name="StudentRadio"
                                     Content="Student"
                                     GroupName="ResetRole"
                                     IsChecked="True"
                                     Margin="0,0,5,0"
                                     Style="{StaticResource RoleToggleButton}"/>
                        <RadioButton x:Name="TeacherRadio"
                                     Content="Teacher"
                                     GroupName="ResetRole"
                                     Margin="5,0,0,0"
                                     Style="{StaticResource RoleToggleButton}"/>
                    </UniformGrid>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}"/>
                    <TextBlock x:Name="EmailError"
                               Text="Enter your email address."
                               Style="{StaticResource ErrorText}"/>

                    <Button x:Name="ContinueButton"
                            Content="CONTINUE"
                            Margin="0,22,0,0"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Click="Continue_Click"/>
                </StackPanel>

                
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Security question" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="QuestionText"
                               Margin="2,0,0,12"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{StaticResource DarkText}"/>

                    <TextBlock Text="Your answer" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AnswerBox" Style="{StaticResource ModernTextBox}"/>
                    <TextBlock x:Name="AnswerError"
                               Text="Enter your answer."
                               Style="{StaticResource ErrorText}"/>

                    <TextBlock Text="New password" Margin="2,16,0,6" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource ModernPasswordBox}"/>
                    <TextBlock x:Name="NewPasswordError"
                               Text="Use at least 8 characters."
                               Style="{StaticResource ErrorText}"/>

                    <TextBlock Text="Confirm new password" Margin="2,16,0,6" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModernPasswordBox}"/>
                    <TextBlock x:Name="ConfirmError"
                               Text="Passwords don't match."
                               Style="{StaticResource ErrorText}"/>

                    <Button x:Name="ResetButton"
                            Content="RESET PASSWORD"
                            Margin="0,22,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="Reset_Click"/>
                </StackPanel>

                <TextBlock x:Name="FormError"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource ErrorText}"/>

                <Button Content="Back to login"
                        HorizontalAlignment="Center"
                        Margin="0,22,0,0"
                        Style="{StaticResource LinkButton}"
                        Click="BackToLogin_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
