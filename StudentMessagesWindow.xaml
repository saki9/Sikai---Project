<Window x:Class="Sikai_Project.StudentMessagesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Messages &amp; Notifications - SIKAI" Height="760" Width="1180" WindowStartupLocation="CenterScreen" Background="#F7F4FC">
 <Window.Resources><Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#7567D9"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/></Style></Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="White" BorderBrush="#E6E0EF" BorderThickness="0,0,0,1"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="← Back" Padding="12,7" VerticalAlignment="Center" Click="BackButton_Click"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="Messages &amp; Notifications" FontSize="22" FontWeight="Bold" Foreground="#393343"/><TextBlock Text="Chat with teachers in your classes and view updates." FontSize="12" Foreground="#817A8D"/></StackPanel><TextBlock Grid.Column="2" x:Name="StudentNameText" Text="Student" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#393343"/></Grid></Border>
 <Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Teachers" FontSize="18" FontWeight="SemiBold" Margin="4,4,4,12"/><ListBox x:Name="ContactsList" DisplayMemberPath="Display" SelectionChanged="ContactsList_SelectionChanged" BorderBrush="#E7E3EF"/></DockPanel></Border>
 <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="14" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="ConversationTitle" Text="Select a teacher" FontSize="18" FontWeight="SemiBold" Margin="6,4,6,12"/><ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MessagesPanel"/></ScrollViewer><TextBox x:Name="MessageBox" Grid.Row="2" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" Margin="6,8,6,8"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#77738A" Margin="0,0,12,0"/><Button Content="Send" Style="{StaticResource PrimaryButton}" Click="Send_Click"/></StackPanel></Grid></Border>
 <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Notifications" FontSize="18" FontWeight="SemiBold" Margin="4,4,4,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NotificationsPanel"/></ScrollViewer></DockPanel></Border></Grid>
 </Grid>
</Window>
